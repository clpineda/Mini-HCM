# Backend
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:4000

# Firebase client config for the frontend
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Admin config for the backend
FIREBASE_PROJECT_ID=your-project-id

# Option A: use service account values from Firebase Admin SDK settings.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key value from your service account JSON.
# Keep newline characters escaped as \n when storing this in .env.
FIREBASE_PRIVATE_KEY="paste-escaped-service-account-private-key-here"

# Option B: use Application Default Credentials instead of the values above.
# Set this to a service account JSON path that exists inside the backend container.
GOOGLE_APPLICATION_CREDENTIALS=
